{
  "flows": [
    {
      "id": "start",
      "name": "Erste Schritte",
      "when": "Die allerersten Bildschirme nach dem Öffnen der App. Die Leserin hat noch kein Konto und weiß noch nicht, was Lexie ist."
    },
    {
      "id": "signin",
      "name": "Anmelden",
      "when": "Anmeldung per E-Mail-Code, im Browser. Sie kommt entweder von der Website oder hat die App schon benutzt."
    },
    {
      "id": "upgrade",
      "name": "Auf Pro upgraden",
      "when": "Die Bezahlseite. Sie erscheint nach dem Onboarding und wieder, sobald die drei kostenlosen Lernsets aufgebraucht sind."
    },
    {
      "id": "home",
      "name": "Startseite",
      "when": "Der Startbildschirm der App bei jedem Öffnen. Kurze Texte, viel Weißraum, alles hier wird hundertmal gelesen."
    },
    {
      "id": "flashcards",
      "name": "Karteikarten lernen",
      "when": "Eine Karte nach der anderen: lesen, umdrehen, selbst einschätzen. Die zwei Bewertungsknöpfe stehen direkt nebeneinander und müssen sich klar unterscheiden."
    },
    {
      "id": "quiz",
      "name": "Quiz üben",
      "when": "Fragen beantworten und sofort Rückmeldung bekommen. Die Rückmeldungen sind das Herz des Produkts: sie erscheinen im Moment des Irrtums und dürfen weder herablassend noch überschwänglich klingen."
    },
    {
      "id": "web",
      "name": "Website",
      "when": "Die öffentliche Website, bevor jemand die App kennt."
    },
    {
      "id": "everywhere",
      "name": "Überall",
      "when": "Knöpfe, die in fast jedem Dialog vorkommen. Sie stehen ohne Kontext da, also müssen sie für sich allein verständlich sein."
    }
  ],
  "addressForm": "du",
  "voice": "du throughout, never Sie. Sentence case, not Title Case and not all caps. Say it the way a person who knows the subject would say it out loud, not the way a manual would. No filler, no exclamation marks stacked on praise, no em-dashes. Prefer a short common word to a long formal one: 'Los geht's' over 'Beginnen Sie den Vorgang'. Avoid Denglisch where a real German word exists, but keep a loanword that German students actually say. Compound nouns are normal German; do not split them to look friendlier. Where English is playful and Finnish is plain, follow the Finnish: it was voiced deliberately, the English is partly just the original.",
